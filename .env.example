# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env ne doit jamais être versionné.

# --- SensCritique ---
# Pseudo du profil dont on lit les envies (liste publique)
SC_USERNAME=
# Endpoint GraphQL utilisé par le site SensCritique
SC_GRAPHQL_URL=https://apollo.senscritique.com/
# Nombre d'envies récupérées par requête (max 500)
SC_PAGE_SIZE=500

# --- Seerr (ex-Overseerr) ---
# URL de base de l'instance, sans /api/v1 (ex : http://192.168.1.1:5055)
SEERR_URL=
# Clé API : Paramètres > Général dans Seerr
SEERR_API_KEY=
# Langue des titres renvoyés par la recherche
SEERR_LANGUAGE=fr
# Recherches Seerr simultanées (1-20)
SEERR_CONCURRENCY=5
# Pages de résultats parcourues quand la première ne donne rien (titres courts)
SEERR_SEARCH_PAGES=3

# --- Réseau ---
# Timeout des requêtes HTTP, en secondes
HTTP_TIMEOUT=30
# Nouvelles tentatives sur erreur réseau / 429 / 5xx
HTTP_RETRIES=3

# --- Rapprochement ---
# Écart d'années accepté entre SensCritique et TMDB (+1 si le titre est identique)
MATCH_YEAR_TOLERANCE=1

# --- Sorties ---
# Fichier de log (tout y est écrit)
LOG_FILE=logs/sc_to_seerr.log
# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Export CSV des résultats
CSV_OUTPUT=output/wishlist_status.csv
CSV_OUTPUT_TV=output/series_status.csv
# Cache des correspondances SensCritique -> TMDB (corrections manuelles possibles)
CACHE_FILE=data/matches.json
CACHE_FILE_TV=data/matches_tv.json
